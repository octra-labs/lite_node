contract GoodFormalDeployProgram {
  invariant supply_conserved = sum(balances) == total_supply

  state {
    owner: address
    total_supply: u128
    balances: map[address]u128
  }

  event Transfer(from: address, to: address, amount: u128)

  constructor(supply: u128) {
    require(supply > 0, "supply must be positive")
    self.owner = origin
    self.total_supply = supply
    self.balances[origin] = supply
    emit Transfer(origin, origin, supply)
  }

  private fn safe_add(left: u128, right: u128): u128 {
    let out: u128 = left + right
    require(out >= left, "u128 overflow")
    return out
  }

  view fn balance_of(addr: address): u128 {
    return self.balances[addr]
  }

  view fn get_total_supply(): u128 {
    return self.total_supply
  }

  fn transfer(to: address, amount: u128): bool {
    assert_address(to)
    require(amount > 0, "amount must be positive")
    require(to != caller, "self transfer disabled")
    let bal = self.balances[caller]
    require(bal >= amount, "insufficient balance")
    let next_to = safe_add(self.balances[to], amount)
    self.balances[caller] = bal - amount
    self.balances[to] = next_to
    emit Transfer(caller, to, amount)
    return true
  }
}