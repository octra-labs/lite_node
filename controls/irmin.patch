+    if (error != 0) { errno = error; uerror("GC descriptor listing", Nothing); }
+    for (int fd = maximum; fd >= 3; --fd)
+      if (fd != Int_val(lease) && close(fd) != 0 && errno != EBADF) uerror("close", Nothing);
+  }
+  int sink = open("/dev/null", O_RDWR);
+  if (sink < 0) uerror("open", Nothing);
+  for (int fd = 0; fd < 3; ++fd)
+    if (dup2(sink, fd) < 0) uerror("dup2", Nothing);
+  if (sink > 2 && close(sink) != 0) uerror("close", Nothing);
+  if (Long_val(owner) != getppid()) caml_failwith("GC child owner changed");
+  return Val_unit;
+}
