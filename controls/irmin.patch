+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static char gate_ready[PATH_MAX];
+static char gate_release[PATH_MAX];
+static char sync_path[PATH_MAX];
+static int sync_after;
+
+CAMLprim value irmin_test_sync(value path, value after)
+{
+  if (caml_string_length(path) >= PATH_MAX) caml_invalid_argument("Sync path too long");
+  memcpy(sync_path, String_val(path), caml_string_length(path) + 1);
+  sync_after = Int_val(after);
+  return Val_unit;
+}
+
+int fsync(int fd)
+{
+  static int (*system_sync)(int);
+  if (system_sync == NULL) system_sync = dlsym(RTLD_NEXT, "fsync");
+  if (system_sync == NULL) { errno = ENOSYS; return -1; }
+  if (sync_after > 0) {
+    char path[PATH_MAX];
+#ifdef __APPLE__
+    int found = fcntl(fd, F_GETPATH, path) == 0;
+#else
+    char link[64];
+    snprintf(link, sizeof(link), "/proc/self/fd/%d", fd);
+    ssize_t size = readlink(link, path, sizeof(path) - 1);
+    int found = size >= 0;
+    if (found) path[size] = '\0';
+#endif
+    if (found && strcmp(path, sync_path) == 0 && --sync_after == 0) {
+      errno = EIO;
+      return -1;
+    }
+  }
+  return system_sync(fd);
+}
+
+static void gate_child(void)
+{
+  if (gate_ready[0] == '\0') return;
+  int fd = open(gate_ready, O_CREAT | O_EXCL | O_WRONLY, 0600);
+  if (fd < 0 || close(fd) != 0) _exit(125);
+  for (int count = 0; count < 500; ++count) {
+    if (access(gate_release, F_OK) == 0) {
+      gate_ready[0] = '\0';
+      gate_release[0] = '\0';
+      return;
+    }
+    usleep(10000);
+  }
+  _exit(125);
+}
+
+CAMLprim value irmin_test_gate(value ready, value release)
+{
+  static int installed = 0;
+  if (caml_string_length(ready) >= PATH_MAX || caml_string_length(release) >= PATH_MAX)
+    caml_invalid_argument("Test gate path is too long");
+  if (!installed) {
+    if (pthread_atfork(NULL, NULL, gate_child) != 0) caml_failwith("Test fork hook failed");
+    installed = 1;
+  }
+  memcpy(gate_ready, String_val(ready), caml_string_length(ready) + 1);
+  memcpy(gate_release, String_val(release), caml_string_length(release) + 1);
+  return Val_unit;
+}
+
+CAMLprim value irmin_test_exited(value process)
+{
+  CAMLparam1(process);
+  intnat pid = Long_val(process);
+  if (pid <= 0 || pid > INT_MAX) caml_invalid_argument("Child PID is invalid");
+  siginfo_t info;
+  memset(&info, 0, sizeof(info));
+  if (waitid(P_PID, (id_t)pid, &info, WEXITED | WNOHANG | WNOWAIT) != 0) {
+    if (errno == EINTR) CAMLreturn(Val_false);
+    uerror("waitid", Nothing);
+  }
+  CAMLreturn(Val_bool(info.si_pid == pid));
+}
+
+CAMLprim value irmin_test_store_fds(value root)
+{
+  CAMLparam1(root);
+#ifdef __APPLE__
+  DIR *directory = opendir("/dev/fd");
+#else
+  DIR *directory = opendir("/proc/self/fd");
+#endif
+  if (directory == NULL) uerror("opendir", Nothing);
+  int count = 0;
+  int error = 0;
+  size_t length = caml_string_length(root);
+  for (;;) {
+    errno = 0;
+    struct dirent *entry = readdir(directory);
+    if (entry == NULL) {
+      error = errno;
+      break;
+    }
+    char *end;
+    errno = 0;
+    long fd = strtol(entry->d_name, &end, 10);
+    if (errno != 0 || end == entry->d_name || *end != '\0' || fd < 0 || fd > INT_MAX) continue;
+    char path[PATH_MAX];
+#ifdef __APPLE__
+    if (fcntl((int)fd, F_GETPATH, path) != 0) continue;
+#else
+    char link[64];
+    snprintf(link, sizeof(link), "/proc/self/fd/%ld", fd);
+    ssize_t size = readlink(link, path, sizeof(path) - 1);
+    if (size < 0) continue;
+    path[size] = '\0';
+#endif
+    if (strlen(path) > length && path[length] == '/' &&
+        memcmp(path, String_val(root), length) == 0) ++count;
+  }
+  if (closedir(directory) != 0 && error == 0) error = errno;
+  if (error != 0) {
+    errno = error;
+    uerror("readdir", Nothing);
+  }
+  CAMLreturn(Val_int(count));
+}
