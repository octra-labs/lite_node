+module Key = Index.Key.String_fixed (struct let length = 20 end)
+module Value = Index.Value.String_fixed (struct let length = 20 end)
+module I = Index_unix.Private.Make (Key) (Value) (Index.Cache.Unbounded)
+
+let send fd = ignore (Unix.write_substring fd "x" 0 1)
+let receive fd =
+  if Unix.read fd (Bytes.create 1) 0 1 <> 1 then failwith "Gate closed"
+
+let test_merge_failure () =
+  let root = "_build/index-gc-failure" in
+  let failing = ref false in
+  let t = I.v ~fresh:true ~log_size:100000 root
+      ~flush_callback:(fun () -> if !failing then failwith "Index flush refused") in
+  I.replace ~overcommit:true t (String.make 20 'k') (String.make 20 'v');
+  failing := true;
+  let refused = try ignore (I.try_merge_aux ~force:true t); false
+    with Failure message when message = "Index flush refused" -> true in
+  Alcotest.(check bool) "merge startup failure reported" true refused;
+  Alcotest.(check bool) "failed merge releases ownership" false (I.is_merging t);
+  I.abort t;
+  Alcotest.(check int) "failed merge files closed" 0 (Test_async.store_fds (Unix.realpath root));
+  Lwt.return_unit
+
+let test_exclusive wait =
+  let root = "_build/index-gc-exclusive" in
+  let t = I.v ~fresh:true ~log_size:100000 root in
+  I.replace ~overcommit:true t (String.make 20 'k') (String.make 20 'v');
+  let entered, signal = Unix.pipe () in
+  let release, resume = Unix.pipe () in
+  let completed = ref false in
+  let hook = Index.Private.Hook.v (function
+    | `After_clear -> send signal; receive release
+    | `After -> completed := true
+    | _ -> ()) in
+  let work = I.try_merge_aux ~force:true ~hook t in
+  receive entered;
+  let thread = Thread.create (fun () -> Thread.delay 0.1; send resume) () in
+  let observed = if wait then Some (I.with_exclusive t (fun () -> !completed))
+    else I.try_exclusive t (fun () -> !completed) in
+  Thread.join thread;
+  let result = I.await work in
+  List.iter Unix.close [entered; signal; release; resume];
+  I.abort t;
+  Alcotest.(check (option bool)) "exclusive action follows merge"
+    (if wait then Some true else None) observed;
+  Alcotest.(check bool) "held merge completed" true (result = Ok `Completed);
+  Alcotest.(check int) "exclusive files closed" 0 (Test_async.store_fds (Unix.realpath root));
+  Lwt.return_unit
+
+let test_reentry () =
+  let t = I.v ~fresh:true ~log_size:100000 "_build/index-gc-reentry" in
+  I.replace ~overcommit:true t (String.make 20 'k') (String.make 20 'v');
+  let refused = I.with_exclusive t (fun () ->
+    try I.flush t; false with Invalid_argument _ -> true) in
+  Alcotest.(check bool) "exclusive mutation refuses reentry" true refused;
+  I.flush t;
+  I.close t;
+  Lwt.return_unit
+
+let test_shared_abort () =
+  let root = "_build/index-gc-shared" in
+  let cache = I.empty_cache () in
+  let first = I.v ~cache ~fresh:true ~log_size:100000 root in
+  let second = I.v ~cache ~log_size:100000 root in
+  let refused = try I.abort first; false with Invalid_argument _ -> true in
+  Alcotest.(check bool) "shared abort requires ownership" true refused;
+  I.replace first (String.make 20 'k') (String.make 20 'v');
+  Alcotest.(check string) "shared handle remains readable" (String.make 20 'v')
+    (I.find second (String.make 20 'k'));
+  I.close second;
+  I.abort first;
+  Alcotest.(check int) "shared files closed" 0 (Test_async.store_fds (Unix.realpath root));
+  Lwt.return_unit
+
+let test_abort_buffers () =
