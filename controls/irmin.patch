+  let run_case = function
+    | "callback" -> eager_callback ()
+    | "batch_overlap" -> eager_batch `Overlap
+    | "batch_close" -> eager_batch `Close
+    | "batch_cancel" -> eager_batch `Cancel
+    | "cleanup_failure" -> Test_async.run_case test_cleanup_failure
+    | "debt_restart" -> test_debt_restart "worker"; Unix._exit 0
+    | "debt_spawn" -> test_debt_restart "spawn"; Unix._exit 0
+    | "debt_publish" -> test_debt_restart "publish"; Unix._exit 0
+    | "debt_cleanup" -> test_debt_restart "cleanup"; Unix._exit 0
+    | "debt_moved" -> test_debt_restart "moved"; Unix._exit 0
+    | "debt_slash" -> test_debt_restart "slash"; Unix._exit 0
+    | "debt_lease" -> test_debt_lease (); Unix._exit 0
+    | "debt_save_failure" -> Test_async.run_case test_debt_save_failure
+    | "export_unlink" -> Test_async.run_case test_export_unlink_error
