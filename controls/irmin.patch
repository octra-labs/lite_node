+  let eager_batch mode =
+    let t = Lwt_main.run (init ()) in
+    let gate, resume = Lwt.wait () in
+    let works = ref [] in
+    let track work = works := work :: !works; work in
+    let release () = if Lwt.is_sleeping gate then Lwt.wakeup_later resume () in
+    Fun.protect
+      ~finally:(fun () ->
+        release ();
+        Lwt_main.run (Lwt.no_cancel (
+          let* () = Lwt_list.iter_s
+            (fun work -> Lwt.catch (fun () -> work) (fun _ -> Lwt.return_unit))
+            !works in
+          S.Repo.close t.repo)))
+      (fun () ->
+        let t, commit = Lwt_main.run (commit_1 t) in
+        let before = generation t in
+        let entered, enter = Lwt.wait () in
+        let observed, observe = Lwt.wait () in
+        let action = ref None in
+        let calls = ref 0 in
+        let finished result =
+          incr calls;
+          let work = track (Lwt.catch (fun () ->
+              (match result with
+              | Ok _ -> ()
+              | Error (`Msg reason) -> Alcotest.fail reason);
+              match mode with
+              | `Overlap -> S.Backend.Repo.batch t.repo (fun _ _ _ ->
+                  Lwt.wakeup_later enter ();
+                  gate)
+              | `Close -> S.Repo.close t.repo
+              | `Cancel -> let+ _ = S.Gc.cancel t.repo in ()) Lwt.fail)
+          in
+          action := Some work;
+          Lwt.on_failure work (fun error ->
+              if Lwt.is_sleeping entered then Lwt.wakeup_later_exn enter error);
+          Lwt.wakeup_later observe ();
+          work
+        in
+        let started = Lwt_main.run (S.Gc.run ~finished t.repo (S.Commit.key commit)) in
+        Alcotest.(check bool) "GC started" true (started = Ok true);
+        let pid = owned_pid t in
+        Lwt_main.run (S.Internal.await_gc_worker t.repo);
+        let first = track (Lwt.catch
+          (fun () -> S.Backend.Repo.batch t.repo (fun _ _ _ ->
+              match mode with
+              | `Overlap -> Lwt.return_unit
+              | `Close | `Cancel -> Lwt.wakeup_later enter (); gate))
+          Lwt.fail)
+        in
+        Lwt.on_failure first (fun error ->
+            if Lwt.is_sleeping entered then Lwt.wakeup_later_exn enter error);
+        (match mode with
+        | `Overlap ->
+            Lwt_main.run (Lwt_unix.with_timeout 2. (fun () -> Lwt.protected observed));
+            let action = match !action with Some work -> work | None -> assert false in
+            check_pending "callback joins live reservation" action;
+            Lwt_main.run (Lwt_unix.with_timeout 2. (fun () -> Lwt.protected entered));
+            Lwt_main.run first;
+            check_pending "callback body remains active" action;
+            let closed = track (S.Repo.close t.repo) in
+            check_pending "close keeps callback batch" closed;
+            release ();
+            Lwt_main.run action;
+            Lwt_main.run closed
+        | `Close | `Cancel ->
+            Lwt_main.run (Lwt_unix.with_timeout 2. (fun () -> Lwt.protected entered));
+            Lwt_main.run (Lwt.pause ());
+            check_pending "outer body remains active" first;
+            check_pending "callback waits for outer release" observed;
+            Alcotest.(check int) "no callback inside outer batch" 0 !calls;
+            release ();
+            Lwt_main.run first;
+            Lwt_main.run (Lwt_unix.with_timeout 2. (fun () -> Lwt.protected observed));
+            let action = match !action with Some work -> work | None -> assert false in
+            Lwt_main.run action);
+        Alcotest.(check int) "callback called once" 1 !calls;
+        Test_async.check_reaped pid;
+        if mode <> `Close && mode <> `Overlap then
+          Alcotest.(check int) "GC published once" (before + 1) (generation t))
