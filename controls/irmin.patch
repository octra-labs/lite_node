+
+CAMLprim value irmin_exit_mask(value unit)
+{
+  sigset_t signals;
+  if (sigfillset(&signals) != 0 || sigprocmask(SIG_BLOCK, &signals, NULL) != 0)
+    uerror("sigprocmask", Nothing);
+  return Val_unit;
+}
+
+CAMLprim value irmin_exit_retain(value unit)
+{
+  sigset_t signals;
+  sigfillset(&signals);
+  sigprocmask(SIG_BLOCK, &signals, NULL);
+  kill(getpid(), SIGSTOP);
+  for (;;) pause();
+}
+
+CAMLprim value irmin_exit_reap(value owner, value child)
+{
+  if (Long_val(owner) != getpid() || Long_val(child) <= 0 || Long_val(child) > INT_MAX)
+    return Val_int(ECHILD);
+  pid_t pid = (pid_t)Long_val(child);
+  int status;
+  pid_t found;
+  do { found = waitpid(pid, &status, WNOHANG); } while (found < 0 && errno == EINTR);
+  if (found == pid) return Val_int(0);
+  if (found < 0) return Val_int(errno);
+  if (kill(pid, SIGKILL) != 0 && errno != ESRCH) return Val_int(errno);
+  do { found = waitpid(pid, &status, 0); } while (found < 0 && errno == EINTR);
+  return Val_int(found == pid ? 0 : errno);
+}
+
+CAMLprim value irmin_gc_lock(value root)
+{
+  char *path;
+  if (asprintf(&path, "%s/store.gc-lock", String_val(root)) < 0)
+    caml_raise_out_of_memory();
+  int fd = open(path, O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+  free(path);
+  if (fd < 0) uerror("open GC lock", Nothing);
+  if (fd < 3) {
+    int copy = fcntl(fd, F_DUPFD_CLOEXEC, 3);
+    int error = errno;
+    close(fd);
+    if (copy < 0) { errno = error; uerror("duplicate GC lock", Nothing); }
+    fd = copy;
+  }
+  struct stat stats;
+  int valid = fstat(fd, &stats);
+  if (valid == 0 && !S_ISREG(stats.st_mode)) { errno = EINVAL; valid = -1; }
+  if (valid != 0 || flock(fd, LOCK_EX | LOCK_NB) != 0) {
+    int error = errno == 0 ? EINVAL : errno;
+    close(fd);
+    errno = error;
+    uerror("flock GC", Nothing);
+  }
+  return Val_int(fd);
+}
+
+CAMLprim value irmin_gc_child_isolate(value owner, value lease)
+{
+  if (Long_val(owner) == getpid() || Long_val(owner) != getppid())
+    caml_failwith("GC child owner differs");
+#ifdef __linux__
+  if (prctl(PR_SET_PDEATHSIG, SIGKILL, 0UL, 0UL, 0UL) != 0) uerror("prctl", Nothing);
+#endif
+  int closed = 0;
+#if defined(__linux__) && defined(SYS_close_range)
+  unsigned int retained = Int_val(lease);
+  closed = (retained <= 3U || syscall(SYS_close_range, 3U, retained - 1U, 0U) == 0)
+    && syscall(SYS_close_range, retained + 1U, UINT_MAX, 0U) == 0;
+#endif
+  if (!closed) {
+#ifdef __linux__
+    DIR *directory = opendir("/proc/self/fd");
+#else
+    DIR *directory = opendir("/dev/fd");
+#endif
+    if (directory == NULL) uerror("opendir", Nothing);
+    int maximum = 2;
+    int error = 0;
+    for (;;) {
+      errno = 0;
+      struct dirent *entry = readdir(directory);
+      if (entry == NULL) { error = errno; break; }
+      if (entry->d_name[0] == '.') continue;
+      char *end;
+      long fd = strtol(entry->d_name, &end, 10);
+      if (errno != 0 || *end != '\0' || fd < 0 || fd > INT_MAX) { error = EINVAL; break; }
+      if (fd > maximum) maximum = (int)fd;
+    }
