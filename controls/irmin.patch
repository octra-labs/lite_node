+      let release () =
+        if Lwt.is_sleeping gate then Lwt.wakeup_later resume ()
+      in
+      releases := release :: !releases;
+      let work = Lwt.catch
+        (fun () -> S.Backend.Repo.batch t.repo (fun _ _ _ ->
+            before ();
+            Lwt.wakeup_later enter ();
+            let* () = gate in
+            after ()))
+        Lwt.fail
+      in
+      works := work :: !works;
+      Lwt.on_failure work (fun error ->
+          if Lwt.is_sleeping entered then Lwt.wakeup_later_exn enter error);
+      (work, entered, release)
+    in
+    Lwt.finalize
+      (fun () -> f hold)
+      (fun () ->
+        List.iter (fun release -> release ()) !releases;
+        Lwt.no_cancel (Lwt_list.iter_s
+          (fun work -> Lwt.catch (fun () -> work) (fun _ -> Lwt.return_unit))
+          !works))
