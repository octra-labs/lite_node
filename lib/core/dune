(include_subdirs unqualified)

(library
 (name octra_core)
 (foreign_stubs
  (language c)
  (names circle_wasm_native_stubs))
 (c_library_flags (:include circle_wasm_native_clib_flags.sexp))
 (libraries
  lwt lwt.unix unix
  cohttp-lwt-unix
  base64
  yojson
  zarith
  uri
  lmdb
  sqlite3
  irmin-pack.unix
  mtime mtime.clock.os
  str
  digestif digestif.c
  mirage-crypto mirage-crypto-ec mirage-crypto-rng.unix
  eqaf
  cstruct
  octra_log
  octra_net
  octra_consensus
  octra_crypto_guard
  pvac_ffi))

(rule
 (targets circle_wasm_native_clib_flags.sexp liboctra_circle_wasm_host.a)
 (deps
  (source_tree circle_wasm_native))
 (action
  (with-stdout-to circle_wasm_native_clib_flags.sexp
   (run env -u BASH_ENV -u ENV
    bash --noprofile --norc -c
    "set -euo pipefail; ROOT=$(cd %{workspace_root} && pwd); TARGET_DIR=\"$ROOT/_cargo_target/circle_wasm_native\"; LOG=\"$TARGET_DIR/native-static-libs.log\"; mkdir -p \"$TARGET_DIR\"; cargo rustc --manifest-path \"$ROOT/lib/core/circle_wasm_native/Cargo.toml\" --target-dir \"$TARGET_DIR\" --release -- --print=native-static-libs >/dev/null 2> \"$LOG\"; cp \"$TARGET_DIR/release/liboctra_circle_wasm_host.a\" liboctra_circle_wasm_host.a; LIBS=$(grep 'native-static-libs:' \"$LOG\" | tail -1 | sed -E 's/.*native-static-libs: //'); echo \"(-L $(pwd) -loctra_circle_wasm_host $LIBS)\""))))