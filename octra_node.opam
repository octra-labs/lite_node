opam-version: "2.0"
synopsis: "Octra lite node pre-release"
maintainer: "Octra Labs"
authors: ["Octra Labs"]
homepage: "https://octra.org"
bug-reports: "https://github.com/octra-labs/lite_node/issues"
license: "BSD-3-Clause"
dev-repo: "git+https://github.com/octra-labs/lite_node.git"
depends: [
  "ocaml" {>= "4.14.2" & < "5.0"}
  "dune" {>= "3.0"}
  "base64"
  "bigstringaf"
  "cohttp-lwt-unix"
  "conf-gmp"
  "conf-libev"
  "conf-pkg-config"
  "cstruct"
  "digestif"
  "eqaf"
  "faraday-lwt-unix"
  "fmt"
  "gluten"
  "h2"
  "h2-lwt-unix"
  "irmin-pack"
  "lmdb"
  "lwt" {= "6.1.2"}
  "mirage-crypto"
  "mirage-crypto-ec"
  "mirage-crypto-rng"
  "mtime"
  "pbrt"
  "tls-lwt"
  "uri"
  "yojson" {= "3.0.0"}
  "zarith"
  "alcotest" {with-test}
  "alcotest-lwt" {with-test}
  "coq" {with-test}
  "conf-npm" {with-test}
]
build: [
  ["mkdir" "-p" "mcl/obj" "mcl/lib"]
  [
    make
    "-C"
    "mcl"
    "MCL_FP_BIT=256"
    "MCL_FR_BIT=256"
    "lib/libmcl.a"
  ]
  [
    "dune"
    "build"
    "--root"
    "."
    "-j"
    jobs
    "--profile"
    "release"
    "bin/octra_node.exe"
  ]
]