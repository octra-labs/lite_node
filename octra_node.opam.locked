opam-version: "2.0"
name: "octra_node"
version: "~dev"
synopsis: "Octra lite node pre-release"
maintainer: "Octra Labs"
authors: "Octra Labs"
homepage: "https://octra.org"
bug-reports: "https://gitlab.octra.org.uk/octra/libv_litecore/issues"
depends: [
  "angstrom" {= "0.16.1"}
  "asn1-combinators" {= "0.3.2"}
  "astring" {= "0.8.5"}
  "base" {= "v0.16.5"}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "base64" {= "3.5.2"}
  "bheap" {= "2.0.0"}
  "bigstringaf" {= "0.10.0"}
  "bos" {= "0.3.0"}
  "ca-certs" {= "1.0.3"}
  "checkseum" {= "0.5.3"}
  "cmdliner" {= "1.3.0"}
  "cohttp" {= "6.1.1"}
  "cohttp-lwt" {= "6.1.1"}
  "cohttp-lwt-unix" {= "6.1.1"}
  "conduit" {= "8.0.0"}
  "conduit-lwt" {= "8.0.0"}
  "conduit-lwt-unix" {= "8.0.0"}
  "conf-gmp" {= "5"}
  "conf-gmp-powm-sec" {= "4"}
  "conf-libev" {= "4-13"}
  "conf-pkg-config" {= "4"}
  "conf-sqlite3" {= "1"}
  "cppo" {= "1.8.0"}
  "csexp" {= "1.5.2"}
  "cstruct" {= "6.2.0"}
  "digestif" {= "1.3.0"}
  "domain-name" {= "0.5.0"}
  "dune" {= "3.23.0"}
  "dune-compiledb" {= "0.6.0"}
  "dune-configurator" {= "3.23.0"}
  "duration" {= "0.3.1"}
  "either" {= "1.0.0"}
  "eqaf" {= "0.10"}
  "ezjsonm" {= "1.3.0"}
  "fmt" {= "0.11.0"}
  "fpath" {= "0.7.3"}
  "gmap" {= "0.3.0"}
  "hex" {= "1.5.0"}
  "http" {= "6.1.1"}
  "index" {= "1.6.2"}
  "ipaddr" {= "5.6.2"}
  "ipaddr-sexp" {= "5.6.2"}
  "irmin" {= "3.11.0"}
  "irmin-pack" {= "3.11.0"}
  "jsonm" {= "1.0.2"}
  "kdf" {= "1.0.0"}
  "lmdb" {= "1.1.1"}
  "logs" {= "0.7.0"}
  "lru" {= "0.3.1"}
  "lwt" {= "6.1.2"}
  "macaddr" {= "5.6.2"}
  "magic-mime" {= "1.3.1"}
  "mirage-crypto" {= "2.1.0"}
  "mirage-crypto-ec" {= "2.1.0"}
  "mirage-crypto-pk" {= "2.1.0"}
  "mirage-crypto-rng" {= "2.1.0"}
  "mtime" {= "2.1.0"}
  "num" {= "1.6"}
  "ocaml" {= "4.14.2"}
  "ocaml-base-compiler" {= "4.14.2"}
  "ocaml-compiler-libs" {= "v0.12.4"}
  "ocaml-config" {= "2"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0"}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.8"}
  "ocamlgraph" {= "2.2.0"}
  "ocplib-endian" {= "1.2"}
  "ohex" {= "0.2.0"}
  "optint" {= "0.3.0"}
  "parsexp" {= "v0.16.0"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "6.0.3"}
  "ppx_irmin" {= "3.11.0"}
  "ppx_repr" {= "0.7.0"}
  "ppx_sexp_conv" {= "v0.16.0"}
  "ppxlib" {= "0.35.0"}
  "progress" {= "0.5.0"}
  "psq" {= "0.2.1"}
  "ptime" {= "1.2.0"}
  "re" {= "1.14.0"}
  "repr" {= "0.7.0"}
  "rresult" {= "0.7.0"}
  "rusage" {= "1.0.0"}
  "semaphore-compat" {= "1.0.2"}
  "seq" {= "base"}
  "sexplib" {= "v0.16.0"}
  "sexplib0" {= "v0.16.0"}
  "sqlite3" {= "5.4.1"}
  "stdlib-shims" {= "0.3.0"}
  "stringext" {= "1.6.0"}
  "terminal" {= "0.5.0"}
  "tls" {= "2.0.4"}
  "tls-lwt" {= "2.0.4"}
  "topkg" {= "1.1.1"}
  "uri" {= "4.4.0"}
  "uri-sexp" {= "4.4.0"}
  "uucp" {= "17.0.0"}
  "uutf" {= "1.0.4"}
  "vector" {= "1.0.0"}
  "x509" {= "1.0.6"}
  "yojson" {= "3.0.0"}
  "zarith" {= "1.14"}
]
build: [
  [make "-C" "mcl" "MCL_FP_BIT=256" "MCL_FR_BIT=256" "lib/libmcl.a"]
  [
    "dune"
    "build"
    "--root"
    "."
    "-j"
    jobs
    "--profile"
    "release"
    "bin/octra_node.exe"
  ]
]