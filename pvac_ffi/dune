(library
 (name pvac_ffi)
 (foreign_stubs
  (language cxx)
  (names pvac_stubs)
  (include_dirs %{project_root}/pvac/include)
  (extra_deps pvac_serialize.hpp)
  (flags (:include flags.sexp)))
 (c_library_flags (:include clib_flags.sexp))
 (libraries bytes threads.posix))

(rule
 (targets flags.sexp)
 (action
  (with-stdout-to flags.sexp
   (bash "EH_FLAGS=''; if [ \"$(uname -s)\" = 'Darwin' ]; then EH_FLAGS='-femit-dwarf-unwind=always'; fi; ARCH=$(uname -m); AES_FLAGS=''; if [ \"$ARCH\" = 'x86_64' ]; then AES_FLAGS='-maes -msse2'; elif [ \"$ARCH\" = 'aarch64' ] || [ \"$ARCH\" = 'arm64' ]; then AES_FLAGS='-march=armv8-a+crypto'; fi; echo \"(-std=c++17 -O2 -fPIC $EH_FLAGS $AES_FLAGS)\""))))

(rule
 (targets clib_flags.sexp)
 (action
  (with-stdout-to clib_flags.sexp
   (bash "if [ \"$(uname -s)\" = 'Darwin' ]; then echo '(-lc++)'; else echo '(-lstdc++)'; fi"))))