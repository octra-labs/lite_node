(rule
 (target cipher_slots.exe)
 (deps cipher_slots.cpp ../pvac_ffi/pvac_serialize.hpp
  (source_tree ../pvac/include))
 (action
  (bash "ARCH=$(uname -m); AES_FLAGS=''; if [ \"$ARCH\" = 'x86_64' ]; then AES_FLAGS='-maes -msse2'; elif [ \"$ARCH\" = 'aarch64' ] || [ \"$ARCH\" = 'arm64' ]; then AES_FLAGS='-march=armv8-a+crypto'; fi; c++ -std=c++17 -O2 $AES_FLAGS -I../pvac/include -I../pvac_ffi %{dep:cipher_slots.cpp} -o %{target}")))

(rule
 (alias runtest)
 (action (run ./cipher_slots.exe)))

