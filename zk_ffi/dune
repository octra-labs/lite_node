(library
 (name zk_ffi)
 (foreign_stubs
  (language cxx)
  (names zk_stubs)
  (flags (:include flags.sexp)))
 (c_library_flags (:include clib_flags.sexp))
 (libraries bytes))

(rule
 (targets flags.sexp)
 (action
  (with-stdout-to flags.sexp
   (bash "find_root () { p=$(cd \"$1\" && pwd); while [ \"$p\" != / ]; do if [ -f \"$p/dune-project\" ] && [ -d \"$p/mcl/include\" ]; then printf '%s\\n' \"$p\"; return 0; fi; p=$(dirname \"$p\"); done; return 1; }; SRC_ROOT=${OCTRA_SRC_ROOT:-$(find_root '%{project_root}')}; test -f \"$SRC_ROOT/dune-project\" && test -d \"$SRC_ROOT/mcl/include\"; echo \"(-std=c++17 -O2 -fPIC -DMCL_FP_BIT=256 -DMCL_FR_BIT=256 -I $SRC_ROOT/mcl/include)\""))))

(rule
 (targets clib_flags.sexp)
 (action
  (with-stdout-to clib_flags.sexp
   (bash "find_root () { p=$(cd \"$1\" && pwd); while [ \"$p\" != / ]; do if [ -f \"$p/dune-project\" ] && [ -d \"$p/mcl/include\" ]; then printf '%s\\n' \"$p\"; return 0; fi; p=$(dirname \"$p\"); done; return 1; }; SRC_ROOT=${OCTRA_SRC_ROOT:-$(find_root '%{project_root}')}; test -f \"$SRC_ROOT/dune-project\" && test -d \"$SRC_ROOT/mcl/lib\"; if [ \"$(uname -s)\" = 'Darwin' ]; then echo \"(-L $SRC_ROOT/mcl/lib -lmcl -lc++)\"; else echo \"(-Wl,--whole-archive $SRC_ROOT/mcl/lib/libmcl.a -Wl,--no-whole-archive -lstdc++)\"; fi"))))